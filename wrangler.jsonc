// Serves the built site as static assets. The free tools (manyxlabs/photo-resizer) live in
// their own repo and Worker; all of /tools and their other paths are forwarded to it.
{
  "name": "website",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/tools*", "/photo-size*", "/_resizer/*", "/sitemap-resizer-*"]
  },
  // The photo-resizer Worker must be deployed before this one: a deploy fails on a
  // binding to a Worker that does not exist yet.
  "services": [{ "binding": "RESIZER", "service": "photo-resizer" }]
}
