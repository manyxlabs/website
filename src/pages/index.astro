---
import Base from '../layouts/Base.astro';
import { tools } from '../data/tools';
import { CALENDLY, EMAIL, FOUNDER, GITHUB } from '../site';

const suggest = `mailto:${EMAIL}?subject=${encodeURIComponent('Tool idea')}`;

const principles = [
  ['One job, done well', 'Each tool fixes one everyday problem, without the clutter.'],
  ['No signup', 'Open it and use it. No account, no email wall.'],
  ['Private by default', 'If a tool can run in your browser, it does, so your files stay with you.'],
  ['No ads, no tricks', 'No pop-ups, no fake download buttons, no upsell traps.'],
];
---

<Base
  title="Manyx Labs - Boring software, built well"
  description="Small, simple tools for everyday jobs. No signup, no ads, and private by default. Built in Bengaluru."
>
  <header class="wrap top">
    <a href="/" class="brand" aria-label="Manyx Labs home">
      <svg width="28" height="28" viewBox="0 0 48 48" aria-hidden="true">
        <defs>
          <mask id="mx" maskUnits="userSpaceOnUse" x="0" y="0" width="48" height="48">
            <rect width="48" height="48" fill="#fff"></rect>
            <circle cx="24" cy="24" r="9" fill="#000"></circle>
          </mask>
        </defs>
        <g mask="url(#mx)" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round">
          <path d="M9 9 C 22 20, 26 28, 39 39"></path>
          <path d="M39 9 C 26 20, 22 28, 9 39"></path>
        </g>
        <circle cx="24" cy="24" r="5" fill="var(--accent)"></circle>
      </svg>
      Manyx Labs
    </a>
    <nav aria-label="Main">
      <a href="#tools">Tools</a>
      <a href="#teams">For teams</a>
    </nav>
  </header>

  <main>
    <section class="wrap hero">
      <p class="eyebrow">Made in Bengaluru</p>
      <h1>Boring software,<br />built well.</h1>
      <p class="lede">
        Small tools for the everyday jobs that shouldn't be a fight. No signup, no ads, and your files stay on
        your device wherever possible.
      </p>
      <div class="actions">
        <a class="btn primary" href="#tools">See the tools</a>
        <a class="btn" href={suggest}>Suggest a tool</a>
      </div>
    </section>

    <section class="wrap" aria-labelledby="how">
      <h2 id="how" class="label">How we build</h2>
      <ul class="grid principles">
        {
          principles.map(([title, body]) => (
            <li>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap" id="tools" aria-labelledby="tools-h">
      <h2 id="tools-h" class="label">Tools</h2>
      <ul class="grid tools">
        {
          tools.map((tool) => (
            <li class="card">
              <span class:list={['badge', tool.status]}>{tool.status === 'live' ? 'Live' : 'In progress'}</span>
              <h3>{tool.status === 'live' ? <a href={tool.href}>{tool.name}</a> : tool.name}</h3>
              <p>{tool.summary}</p>
              {tool.note && <p class="note">{tool.note}</p>}
            </li>
          ))
        }
        <li class="card ghost">
          <h3>What annoys you every day?</h3>
          <p>Tell us the chore. If a small tool can fix it, it goes on the list.</p>
          <a class="link" href={suggest}>Suggest a tool &rarr;</a>
        </li>
      </ul>
    </section>

    <section class="wrap" id="teams" aria-labelledby="teams-h">
      <div class="teams">
        <h2 id="teams-h">We also build for teams</h2>
        <p>
          Behind the tools is an applied AI studio. We design and ship production AI systems: multi-agent
          workflows, retrieval and evals, built to behave the same in production as in the demo.
        </p>
        <div class="actions">
          <a class="btn primary" href={CALENDLY}>Book a call</a>
          <a class="btn" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <div class="foot">
      <p>&copy; {new Date().getFullYear()} Manyx Labs, Bengaluru</p>
      <nav aria-label="Elsewhere">
        <a href={GITHUB}>GitHub</a>
        <a href={FOUNDER}>Founder</a>
        <a href={`mailto:${EMAIL}`}>Email</a>
      </nav>
    </div>
  </footer>
</Base>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 20px;
  }

  nav a {
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  main > section {
    padding-block: 48px;
  }

  .hero {
    padding-block: 72px 56px;
  }

  .eyebrow,
  .label {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .lede {
    max-width: 34rem;
    margin-top: 20px;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 20px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .btn:hover {
    border-color: var(--muted);
  }

  .btn.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .btn.primary:hover {
    filter: brightness(1.08);
  }

  .grid {
    display: grid;
    gap: 16px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .principles {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .principles li {
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .principles p,
  .card p {
    margin-top: 6px;
    color: var(--muted);
  }

  .tools {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }

  .card h3 a {
    text-decoration: none;
  }

  .card h3 a:hover {
    text-decoration: underline;
  }

  .card .note {
    margin-top: auto;
    padding-top: 16px;
    font-size: 0.875rem;
  }

  .badge {
    margin-bottom: 14px;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .badge.building {
    background: var(--border);
    color: var(--muted);
  }

  .badge.live {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .card.ghost {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--muted) 45%, transparent);
    background: transparent;
  }

  .link {
    margin-top: auto;
    padding-top: 16px;
    color: var(--accent);
    font-weight: 550;
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
  }

  .teams {
    padding: 40px 24px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
  }

  @media (min-width: 640px) {
    .teams {
      padding: 48px;
    }
  }

  .teams h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 680;
    letter-spacing: -0.025em;
  }

  .teams p {
    max-width: 38rem;
    margin-top: 12px;
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: space-between;
    padding-block: 32px 40px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
