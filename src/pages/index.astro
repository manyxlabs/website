---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { tools } from '../data/tools';
import { organization } from '../seo';
import { CALENDLY, EMAIL } from '../site';

const suggest = `mailto:${EMAIL}?subject=${encodeURIComponent('Tool idea')}`;

const principles = [
  ['One job, done well', 'Each tool fixes one everyday problem, without the clutter.'],
  ['No signup', 'Open it and use it. No account, no email wall.'],
  ['Private by default', 'If a tool can run in your browser, it does, so your files stay with you.'],
  ['No ads, no tricks', 'No pop-ups, no fake download buttons, no upsell traps.'],
];
---

<Base
  title="Manyx Labs - Boring software, built well"
  description="Small, simple tools for everyday jobs. No signup, no ads, and private by default. Built in Bengaluru."
  schema={[organization, { '@type': 'WebSite', name: 'Manyx Labs', url: 'https://www.manyxlabs.com/', publisher: { '@id': organization['@id'] } }]}
>
  <Header />

  <main>
    <section class="wrap hero">
      <p class="eyebrow">Made in Bengaluru</p>
      <h1>Boring software,<br />built well.</h1>
      <p class="lede">
        Small tools for the everyday jobs that shouldn't be a fight. No signup, no ads, and your files stay on
        your device wherever possible.
      </p>
      <div class="actions">
        <a class="btn primary" href="#tools">See the tools</a>
        <a class="btn" href={suggest}>Suggest a tool</a>
      </div>
    </section>

    <section class="wrap" aria-labelledby="how">
      <h2 id="how" class="label">How we build</h2>
      <ul class="grid principles">
        {
          principles.map(([title, body]) => (
            <li>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap" id="tools" aria-labelledby="tools-h">
      <h2 id="tools-h" class="label">Tools</h2>
      <ul class="grid tools">
        {
          tools.map((tool) => (
            <li class="card">
              <span class:list={['badge', tool.status]}>{tool.status === 'live' ? 'Live' : 'In progress'}</span>
              <h3>{tool.status === 'live' ? <a href={tool.href}>{tool.name}</a> : tool.name}</h3>
              <p>{tool.summary}</p>
              {tool.note && <p class="note">{tool.note}</p>}
            </li>
          ))
        }
        <li class="card ghost">
          <h3>What annoys you every day?</h3>
          <p>Tell us the chore. If a small tool can fix it, it goes on the list.</p>
          <a class="link" href={suggest}>Suggest a tool &rarr;</a>
        </li>
      </ul>
    </section>

    <section class="wrap" id="teams" aria-labelledby="teams-h">
      <div class="teams">
        <h2 id="teams-h">We also build for teams</h2>
        <p>
          Behind the tools is an applied AI studio. We design and ship production AI systems: multi-agent
          workflows, retrieval and evals, built to behave the same in production as in the demo.
        </p>
        <div class="actions">
          <a class="btn primary" href={CALENDLY}>Book a call</a>
          <a class="btn" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>

  main > section {
    padding-block: 48px;
  }

  .hero {
    padding-block: 72px 56px;
  }

  .eyebrow,
  .label {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .lede {
    max-width: 34rem;
    margin-top: 20px;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .grid {
    display: grid;
    gap: 16px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .principles {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .principles li {
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .principles p,
  .card p {
    margin-top: 6px;
    color: var(--muted);
  }

  .tools {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }

  .card h3 a {
    text-decoration: none;
  }

  .card h3 a:hover {
    text-decoration: underline;
  }

  .card .note {
    margin-top: auto;
    padding-top: 16px;
    font-size: 0.875rem;
  }

  .badge {
    margin-bottom: 14px;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .badge.building {
    background: var(--border);
    color: var(--muted);
  }

  .badge.live {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .card.ghost {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--muted) 45%, transparent);
    background: transparent;
  }

  .link {
    margin-top: auto;
    padding-top: 16px;
    color: var(--accent);
    font-weight: 550;
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
  }

  .teams {
    padding: 40px 24px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
  }

  @media (min-width: 640px) {
    .teams {
      padding: 48px;
    }
  }

  .teams h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 680;
    letter-spacing: -0.025em;
  }

  .teams p {
    max-width: 38rem;
    margin-top: 12px;
    color: var(--muted);
  }

</style>
