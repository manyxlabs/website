---
import { pageLocale } from '../../i18n';
import { LANG_PARAMS } from '../../i18n/locales';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = () => LANG_PARAMS.map((lang) => ({ params: { lang } }));

const { t, href } = pageLocale(Astro.url);
---

<Base title={t.notFound.title} description={t.notFound.description} noindex>
  <main class="wrap">
    <p class="eyebrow">404</p>
    <h1>{t.notFound.heading}</h1>
    <a href={href('/')}>{t.notFound.back} &rarr;</a>
  </main>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    min-height: 100svh;
  }

  h1 {
    font-size: clamp(1.875rem, 6vw, 3rem);
    line-height: 1.15;
  }

  a {
    color: rgb(var(--accent-text));
    font-weight: 500;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
