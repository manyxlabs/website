---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { toolHref, tools } from '../../data/tools';
import { pageLocale } from '../../i18n';
import { fmt } from '../../i18n/format';
import { LANG_PARAMS } from '../../i18n/locales';
import Base from '../../layouts/Base.astro';
import { organization, products, website } from '../../seo';
import { CALENDLY, EMAIL } from '../../site';

export const getStaticPaths = () => LANG_PARAMS.map((lang) => ({ params: { lang } }));

const { locale, t } = pageLocale(Astro.url);

// GitHub's mark, from its Octicons set.
const GITHUB_MARK =
  'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z';

// English in every language, like the rest of the mail the maintainer reads.
const idea = `mailto:${EMAIL}?subject=${encodeURIComponent('Product idea')}`;

// 24px line icons, stroked in the accent colour, in the catalogue's order.
const PILLAR_ICONS = [
  'M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9z',
  'M4 5h16v10H4zM8 19h8M12 15v4',
  'M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z',
];
const PRINCIPLE_ICONS = [
  'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
  'M8 11V8a4 4 0 0 1 8 0v3M6 11h12v9H6z',
  'M5 12.5l4.5 4.5L19 7.5',
  'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM5.6 5.6l12.8 12.8',
];
---

<Base title={t.home.title} description={t.home.description} ogAlt={t.home.ogAlt} schema={[organization, website(locale), products(locale)]}>
  <Header />

  <main>
    <section class="wrap hero">
      <h1>{t.home.heading}</h1>
      <p class="lede">{t.home.lede}</p>
      <div class="actions">
        <a class="btn primary" href="#products">{t.home.seeProducts}</a>
        <a class="btn" href="#teams">{t.header.work}</a>
      </div>
    </section>

    <section class="wrap" id="products" aria-labelledby="products-h">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t.home.products.eyebrow}</p>
          <h2 id="products-h">{t.home.products.heading}</h2>
        </div>
        <p>{t.home.products.aside}</p>
      </div>
      <ul class="tools">
        {
          tools.map((tool) => (
            <li class:list={['card', 'glass', tool.status]} style={`--from: ${tool.tint[0]}; --to: ${tool.tint[1]}`}>
              <span class="top-row">
                <span class="glyph" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="24" height="24">
                    <path d={tool.icon} />
                  </svg>
                </span>
                <span class="tags">
                  <span class:list={['badge', tool.status]}>{tool.status === 'live' ? t.home.products.live : t.home.products.building}</span>
                  <span class="category">{t.tools[tool.id].category}</span>
                </span>
              </span>
              <h3>
                {tool.status === 'live' ? (
                  <a href={toolHref(tool, locale)} target="_blank" rel="noopener">
                    {tool.name}
                  </a>
                ) : (
                  tool.name
                )}
              </h3>
              <p>{t.tools[tool.id].summary}</p>
              <div class="card-foot">
                <p class="note">{t.tools[tool.id].note}</p>
                {tool.status === 'live' && (
                  <span class="card-actions">
                    <a class="btn primary small" href={toolHref(tool, locale)} target="_blank" rel="noopener">
                      {t.tools[tool.id].open} &rarr;
                    </a>
                    {tool.source && (
                      <a
                        class="btn small source"
                        href={tool.source}
                        target="_blank"
                        rel="noopener"
                        aria-label={fmt(t.home.products.sourceOf, { name: tool.name })}
                        title={t.home.products.source}
                      >
                        <svg class="gh" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                          <path d={GITHUB_MARK} />
                        </svg>
                      </a>
                    )}
                  </span>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <p class="idea">
        {t.home.products.idea} <a class="link" href={idea}>{t.home.products.share} &rarr;</a>
      </p>
    </section>

    <section class="wrap" aria-labelledby="build-h">
      <div class="section-head">
        <h2 id="build-h">{t.home.build.heading}</h2>
      </div>
      <ul class="pillars">
        {
          t.home.build.pillars.map(([title, body], i) => (
            <li class="glass">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20">
                  <path d={PILLAR_ICONS[i]} />
                </svg>
              </span>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap" aria-labelledby="how">
      <div class="section-head">
        <h2 id="how">{t.home.how.heading}</h2>
      </div>
      <ul class="principles">
        {
          t.home.how.principles.map(([title, body], i) => (
            <li class="glass">
              <span class="icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20">
                  <path d={PRINCIPLE_ICONS[i]} />
                </svg>
              </span>
              <h3>{title}</h3>
              <p>{body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="wrap" id="teams" aria-labelledby="teams-h">
      <div class="teams glass">
        <p class="eyebrow">{t.header.work}</p>
        <h2 id="teams-h">{t.home.teams.heading}</h2>
        <p>{t.home.teams.body}</p>
        <div class="actions">
          <a class="btn primary" href={CALENDLY}>{t.home.teams.book}</a>
          <a class="btn" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  main > section {
    padding-block: 40px;
  }

  /* In-page links land below the sticky header, not under it. */
  section[id] {
    scroll-margin-top: 72px;
  }

  .hero {
    position: relative;
    padding-block: 72px 56px;
  }

  /* A dotted grid that fades out from the headline, so the hero has depth without a picture. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -80px 0 0;
    background:
      radial-gradient(closest-side at 70% 30%, var(--accent-soft), transparent),
      radial-gradient(color-mix(in srgb, var(--muted) 30%, transparent) 1px, transparent 1.5px) 0 0 / 24px 24px;
    mask-image: radial-gradient(ellipse 70% 80% at 60% 30%, #000 30%, transparent 75%);
    pointer-events: none;
    z-index: -1;
  }

  @media (min-width: 880px) {
    .hero {
      padding-block: 120px 80px;
    }
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 15ch;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  /* Indic words run long: at 40px one Tamil word of the headline is wider than a 360px phone. */
  h1:not(:lang(en)) {
    font-size: clamp(2.25rem, 7vw, 4.5rem);
  }

  .lede {
    max-width: 36rem;
    margin-top: 20px;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .icon svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .section-head h2,
  .teams h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 680;
    letter-spacing: -0.025em;
  }

  .section-head > p {
    color: var(--muted);
  }

  .section-head h2 {
    margin-top: 6px;
  }

  .tools,
  .pillars,
  .principles {
    display: grid;
    gap: 16px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .tools {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
    border-radius: 24px;
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }

  /* Each product glows in its own colours, so the two read as products, not list items. */
  .card.live:hover {
    transform: translateY(-3px);
    box-shadow:
      inset 0 1px 0 var(--glass-shine),
      0 24px 60px -24px color-mix(in srgb, var(--from) 55%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card.live:hover {
      transform: none;
    }
  }

  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin-bottom: 20px;
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--from), var(--to));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      0 10px 24px -10px var(--from);
    color: #fff;
  }

  .glyph svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card h3 {
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .card > p {
    margin-top: 10px;
  }

  .idea {
    margin-top: 20px;
    color: var(--muted);
    text-align: center;
  }

  .card.live {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 620;
    letter-spacing: -0.01em;
  }

  .card h3 a {
    text-decoration: none;
  }

  .card h3 a:hover {
    text-decoration: underline;
  }

  .card p,
  .pillars p,
  .principles p {
    margin-top: 6px;
    color: var(--muted);
  }

  .card-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: auto;
    padding-top: 20px;
  }

  .card-foot .note {
    width: 100%;
    margin: 0;
    font-size: 0.875rem;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .gh {
    fill: currentColor;
  }

  /* Icon only, so the actions stay on one line in a three-column grid. */
  .btn.small.source {
    justify-content: center;
    width: 36px;
    padding: 0;
  }

  .btn.small {
    min-height: 36px;
    padding-inline: 16px;
    font-size: 0.875rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: flex-end;
  }

  .category {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .badge {
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .badge.building {
    background: var(--border);
    color: var(--muted);
  }

  .badge.live {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .link {
    color: var(--accent);
    font-weight: 550;
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
  }

  .principles {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .pillars {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .pillars li,
  .principles li {
    padding: 20px;
    border-radius: 20px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 14px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .teams {
    padding: 40px 24px;
    border-radius: 24px;
    background:
      radial-gradient(120% 140% at 100% 0%, var(--accent-soft), transparent 60%),
      var(--glass);
  }

  @media (min-width: 640px) {
    .teams {
      padding: 56px;
    }
  }

  .teams h2 {
    max-width: 20ch;
    margin-top: 12px;
  }

  .teams p:not(.eyebrow) {
    max-width: 38rem;
    margin-top: 12px;
    color: var(--muted);
  }
</style>
