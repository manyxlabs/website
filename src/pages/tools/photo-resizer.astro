---
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { CHECKED, exams, reportHref } from '../../data/formSpecs';
import { breadcrumbs, organization } from '../../seo';
import Base from '../../layouts/Base.astro';
---

<Base
  title="Photo & Signature Resizer for SSC, IBPS, UPSC and PAN forms - Manyx Labs"
  description="Resize a photo or signature to the exact pixels and KB an exam, bank or government form asks for, from JPG, PNG, WebP, HEIC or TIFF. Free, no signup, and nothing is uploaded."
  schema={[
    {
      '@type': 'WebApplication',
      name: 'Photo & Signature Resizer',
      url: 'https://www.manyxlabs.com/tools/photo-resizer/',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
      publisher: { '@id': organization['@id'] },
    },
    breadcrumbs([
      ['Manyx Labs', '/'],
      ['Photo & Signature Resizer', '/tools/photo-resizer/'],
    ]),
  ]}
>
  <Header />

  <main class="wrap">
    <h1>Photo &amp; signature resizer</h1>
    <p class="lede">
      Get your photo or signature to the exact size and KB your form asks for. It all happens on your device;
      nothing is uploaded.
    </p>

    <form id="tool" class="tool" novalidate>
      <section class="panel">
        <h2><span>1</span> Pick a photo or scan</h2>
        <label class="drop" id="drop">
          <input id="file" type="file" accept="image/*,.heic,.heif,.tif,.tiff" />
          <strong>Choose an image</strong>
          <span>or drop it here. JPG, PNG, WebP, HEIC (iPhone), AVIF, TIFF, GIF or BMP.</span>
        </label>
        <p id="file-status" class="hint" aria-live="polite" hidden></p>
        <p id="file-error" class="error" role="alert" hidden></p>
      </section>

      <section class="panel">
        <h2><span>2</span> What does your form ask for?</h2>
        <label class="field">
          Form
          <select id="preset">
            {
              exams.map((exam) => (
                <optgroup label={exam.name}>
                  {exam.specs.map((s) => (
                    <option value={s.id}>
                      {exam.name}: {s.label}
                    </option>
                  ))}
                </optgroup>
              ))
            }
            <option value="custom">Custom size (type it from your form's notice)</option>
          </select>
        </label>

        <div id="custom" class="grid" hidden>
          <label class="field">Width <input id="w" type="number" min="1" step="any" inputmode="decimal" value="3.5" /></label>
          <label class="field">Height <input id="h" type="number" min="1" step="any" inputmode="decimal" value="4.5" /></label>
          <label class="field">
            Unit
            <select id="unit">
              <option value="cm">cm</option>
              <option value="px">pixels</option>
            </select>
          </label>
          <label class="field">DPI <input id="dpi" type="number" min="72" max="1200" step="1" value="300" /></label>
          <label class="field">Min KB <input id="min" type="number" min="0" step="any" value="20" /></label>
          <label class="field">Max KB <input id="max" type="number" min="1" step="any" value="50" /></label>
        </div>
        <p id="spec-error" class="error" role="alert" hidden></p>
        <p id="spec" class="hint"></p>
        <p class="hint">
          <span id="source">
            Source: <a id="source-link" href=""></a>, checked {`${CHECKED.month} ${CHECKED.year}`}.{' '}
          </span>
          Rules change, so check yours before you submit. <a id="report" href={reportHref()}>Spec wrong or changed?</a>
        </p>
      </section>

      <section class="panel" id="adjust" hidden>
        <h2><span>3</span> Adjust and download</h2>
        <div class="stage">
          <canvas id="canvas" tabindex="0" aria-label="Preview. Drag or use arrow keys to move the image."></canvas>
        </div>
        <label class="field">
          Zoom
          <input id="zoom" type="range" min="0" max="1" step="0.001" value="0" />
        </label>
        <label class="check"><input id="clean" type="checkbox" /> Clean up the paper background (for signatures and thumbs)</label>

        <div class="result">
          <p id="result" aria-live="polite"></p>
          <a id="download" class="btn primary" download hidden>Download JPG</a>
        </div>
      </section>
    </form>

    <nav class="guides" aria-labelledby="guides-h">
      <h2 id="guides-h">Size guides</h2>
      <ul>
        {
          exams.map((exam) => (
            <li>
              <a href={`/photo-size/${exam.id}/`}>
                {exam.name} photo and signature size {CHECKED.year}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>

  <Footer />
</Base>

<script>
  import { openImage } from '../../lib/decode';
  import { fitJpeg, maxBytes, minBytes, withDpi } from '../../lib/jpeg';
  import { examOf, exams, kbRange, reportHref } from '../../data/formSpecs';

  const formSpecs = exams.flatMap((e) => e.specs);

  type Target = {
    width: number;
    height: number;
    min: number;
    max: number;
    /** As the form states them, for display; min and max are the byte limits actually enforced. */
    minKB: number;
    maxKB: number;
    dpi?: number;
    scan: boolean;
    fileName?: string;
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fileInput = $<HTMLInputElement>('file');
  const drop = $<HTMLLabelElement>('drop');
  const fileError = $<HTMLParagraphElement>('file-error');
  const fileStatus = $<HTMLParagraphElement>('file-status');
  const preset = $<HTMLSelectElement>('preset');
  const custom = $<HTMLDivElement>('custom');
  const specError = $<HTMLParagraphElement>('spec-error');
  const specLine = $<HTMLParagraphElement>('spec');
  const source = $<HTMLSpanElement>('source');
  const sourceLink = $<HTMLAnchorElement>('source-link');
  const report = $<HTMLAnchorElement>('report');
  const adjust = $<HTMLElement>('adjust');
  const canvas = $<HTMLCanvasElement>('canvas');
  const zoom = $<HTMLInputElement>('zoom');
  const clean = $<HTMLInputElement>('clean');
  const result = $<HTMLParagraphElement>('result');
  const download = $<HTMLAnchorElement>('download');
  const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
  const num = (id: string) => Number($<HTMLInputElement>(id).value);

  let image: ImageBitmap | null = null;
  let target: Target | null = null;
  let offset = { x: 0, y: 0 };
  let url = '';
  let job = 0;

  function show(el: HTMLElement, text: string) {
    el.textContent = text;
    el.hidden = !text;
  }

  function readTarget(): Target | string {
    const spec = formSpecs.find((s) => s.id === preset.value);
    if (spec) {
      const { width, height, minKB, maxKB, scan, fileName } = spec;
      return { width, height, min: minBytes(minKB), max: maxBytes(maxKB), minKB, maxKB, dpi: spec.physical?.dpi, scan, fileName };
    }
    const cm = $<HTMLSelectElement>('unit').value === 'cm';
    const dpi = num('dpi');
    const toPx = (v: number) => Math.round(cm ? (v / 2.54) * dpi : v);
    const [width, height, minKB, maxKB] = [toPx(num('w')), toPx(num('h')), num('min'), num('max')];
    if (!Number.isInteger(dpi) || dpi < 72 || dpi > 1200) return 'DPI must be a whole number from 72 to 1200.';
    if (!(width >= 16 && height >= 16 && width <= 6000 && height <= 6000))
      return 'Width and height must each come to between 16 and 6000 pixels.';
    if (!(maxKB > 0) || !(minKB >= 0)) return 'Enter the KB limits from your form.';
    if (minBytes(minKB) >= maxBytes(maxKB)) return 'Min KB must be smaller than max KB.';
    return { width, height, min: minBytes(minKB), max: maxBytes(maxKB), minKB, maxKB, dpi, scan: false };
  }

  // The zoom slider runs from "whole image visible" to 4x "frame filled", on a log scale.
  function bounds(image: ImageBitmap, target: Target) {
    const contain = Math.min(target.width / image.width, target.height / image.height);
    const cover = Math.max(target.width / image.width, target.height / image.height);
    return { contain, range: (cover * 4) / contain, filled: Math.log(cover / contain) / Math.log((cover * 4) / contain) };
  }

  function scale() {
    if (!image || !target) return 1;
    const { contain, range } = bounds(image, target);
    return contain * Math.pow(range, Number(zoom.value));
  }

  function clamp() {
    if (!image || !target) return;
    const s = scale();
    const axis = (pos: number, frame: number, size: number) =>
      size <= frame ? (frame - size) / 2 : Math.min(0, Math.max(frame - size, pos));
    offset = { x: axis(offset.x, target.width, image.width * s), y: axis(offset.y, target.height, image.height * s) };
  }

  function draw() {
    if (!image || !target) return;
    const s = scale();
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, target.width, target.height);
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(image, offset.x, offset.y, image.width * s, image.height * s);
    if (clean.checked) {
      const px = ctx.getImageData(0, 0, target.width, target.height);
      const d = px.data;
      for (let i = 0; i < d.length; i += 4) {
        const light = 0.299 * d[i] + 0.587 * d[i + 1] + 0.114 * d[i + 2];
        if (light > 165) d[i] = d[i + 1] = d[i + 2] = 255;
      }
      ctx.putImageData(px, 0, 0);
    }
  }

  const kb = (bytes: number) => `${(bytes / 1024).toFixed(1)} KB`;

  async function render() {
    const mine = ++job;
    download.hidden = true;
    if (!image || !target) return;
    const { width, height, dpi } = target;
    draw();
    const encode = (q: number) =>
      new Promise<Uint8Array>((resolve, reject) =>
        canvas.toBlob(
          (b) => (b ? b.arrayBuffer().then((a) => resolve(dpi ? withDpi(new Uint8Array(a), dpi) : new Uint8Array(a))) : reject()),
          'image/jpeg',
          q,
        ),
      );
    const fit = await fitJpeg(encode, target);
    if (mine !== job) return;
    if (!fit.ok) {
      result.textContent = `Even at the lowest quality this is ${kb(fit.smallest)}, over the limit. Use fewer pixels or a higher max KB.`;
      return;
    }
    URL.revokeObjectURL(url);
    url = URL.createObjectURL(new Blob([fit.jpeg as BlobPart], { type: 'image/jpeg' }));
    download.href = url;
    download.download = target.fileName ? `${target.fileName}.jpg` : `${preset.value === 'custom' ? 'image' : preset.value}-${width}x${height}.jpg`;
    download.hidden = false;
    result.textContent =
      `${width} × ${height} px · ${kb(fit.jpeg.length)} · JPG` +
      (dpi ? ` · ${dpi} DPI` : '') +
      (fit.padded ? ' · padded to reach the minimum size' : ` · quality ${Math.round(fit.quality * 100)}%`);
  }

  let timer = 0;
  const later = () => {
    draw();
    clearTimeout(timer);
    timer = window.setTimeout(render, 150);
  };

  function applyTarget() {
    custom.hidden = preset.value !== 'custom';
    const spec = formSpecs.find((s) => s.id === preset.value);
    source.hidden = !spec;
    if (spec) {
      const { source: from } = examOf(spec);
      sourceLink.href = from.url;
      sourceLink.textContent = from.label;
    }
    report.href = reportHref(spec);
    const t = readTarget();
    if (typeof t === 'string') {
      show(specError, t);
      target = null;
      download.hidden = true;
      result.textContent = '';
      return;
    }
    show(specError, '');
    const cm = spec?.physical ? ` (${spec.physical.w} × ${spec.physical.h} cm at ${spec.physical.dpi} DPI)` : '';
    const name = t.fileName ? `, named ${t.fileName}.jpg` : '';
    specLine.textContent = `Output: ${t.width} × ${t.height} px${cm}, ${kbRange(t)}, JPG${name}.`;
    const changedShape = !target || target.width !== t.width || target.height !== t.height;
    target = t;
    canvas.width = t.width;
    canvas.height = t.height;
    canvas.style.setProperty('--ratio', String(t.width / t.height));
    if (changedShape && image) {
      // Photos start filling the frame, centred on the subject; scans start whole, since a cropped signature is useless.
      clean.checked = t.scan;
      zoom.value = String(t.scan ? 0 : bounds(image, t).filled);
      const s = scale();
      offset = { x: (t.width - image.width * s) / 2, y: (t.height - image.height * s) / 2 };
    }
    clamp();
    later();
  }

  let opening = 0;
  async function load(file: File | undefined) {
    if (!file) return;
    const mine = ++opening;
    show(fileError, '');
    show(fileStatus, `Opening "${file.name}"…`);
    let next: ImageBitmap;
    try {
      next = await openImage(file);
    } catch {
      if (mine === opening) {
        show(fileStatus, '');
        show(fileError, `Couldn't open "${file.name}". Use a photo or scan: JPG, PNG, WebP, HEIC, AVIF, TIFF, GIF or BMP.`);
      }
      return;
    }
    // A slow HEIC decode must not land on top of a file picked after it.
    if (mine !== opening) return next.close();
    show(fileStatus, '');
    image?.close();
    image = next;
    adjust.hidden = false;
    target = null;
    applyTarget();
  }

  fileInput.addEventListener('change', () => load(fileInput.files?.[0]));
  drop.addEventListener('dragover', (e) => e.preventDefault());
  drop.addEventListener('drop', (e) => {
    e.preventDefault();
    load(e.dataTransfer?.files[0]);
  });
  preset.addEventListener('change', applyTarget);
  custom.addEventListener('input', applyTarget);
  clean.addEventListener('change', later);
  zoom.addEventListener('input', () => {
    if (!image || !target) return;
    // Zoom around the frame centre so the subject stays put.
    const before = scale();
    const cx = (target.width / 2 - offset.x) / before;
    const cy = (target.height / 2 - offset.y) / before;
    const after = scale();
    offset = { x: target.width / 2 - cx * after, y: target.height / 2 - cy * after };
    clamp();
    later();
  });

  let dragFrom: { x: number; y: number } | null = null;
  canvas.addEventListener('pointerdown', (e) => {
    canvas.setPointerCapture(e.pointerId);
    dragFrom = { x: e.clientX, y: e.clientY };
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragFrom || !target) return;
    const k = target.width / canvas.getBoundingClientRect().width;
    offset = { x: offset.x + (e.clientX - dragFrom.x) * k, y: offset.y + (e.clientY - dragFrom.y) * k };
    dragFrom = { x: e.clientX, y: e.clientY };
    clamp();
    later();
  });
  canvas.addEventListener('pointerup', () => (dragFrom = null));
  canvas.addEventListener('pointercancel', () => (dragFrom = null));
  canvas.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 10 : 2;
    const move = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] }[e.key];
    if (!move) return;
    e.preventDefault();
    offset = { x: offset.x + move[0], y: offset.y + move[1] };
    clamp();
    later();
  });
  $<HTMLFormElement>('tool').addEventListener('submit', (e) => e.preventDefault());

  // The size guides link here with ?preset=<id>.
  const wanted = new URLSearchParams(location.search).get('preset');
  if (wanted && formSpecs.some((s) => s.id === wanted)) preset.value = wanted;
  applyTarget();
</script>

<style>
  main {
    max-width: 760px;
    padding-block: 32px 64px;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .lede {
    margin-top: 8px;
    color: var(--muted);
  }

  .tool {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }

  .panel {
    display: grid;
    gap: 14px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.0625rem;
    font-weight: 620;
  }

  h2 span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8125rem;
  }

  .drop {
    display: grid;
    gap: 4px;
    justify-items: center;
    padding: 28px 16px;
    border: 1px dashed color-mix(in srgb, var(--muted) 45%, transparent);
    border-radius: 12px;
    color: var(--muted);
    text-align: center;
    cursor: pointer;
  }

  .drop strong {
    color: var(--accent);
  }

  .drop:hover,
  .drop:focus-within {
    border-color: var(--accent);
  }

  .drop input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (min-width: 560px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .field {
    display: grid;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 550;
  }

  select,
  input[type='number'] {
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-weight: 400;
  }

  input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
  }

  .check {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 0.9375rem;
  }

  .check input {
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
  }

  .hint {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .error {
    color: #dc2626;
    font-size: 0.875rem;
  }

  .stage {
    display: grid;
    place-items: center;
    padding: 16px;
    border-radius: 12px;
    background: repeating-conic-gradient(var(--border) 0 25%, transparent 0 50%) 0 0 / 16px 16px;
  }

  canvas {
    /* Wide signatures are capped by width, tall photos by height, so the box always matches the image. */
    width: min(100%, 360px, 420px * var(--ratio, 1));
    aspect-ratio: var(--ratio, 1);
    box-shadow: 0 0 0 1px var(--border);
    cursor: grab;
    touch-action: none;
  }

  canvas:active {
    cursor: grabbing;
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
  }

  .guides {
    margin-top: 40px;
  }

  .guides ul {
    display: grid;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .guides a,
  .hint a {
    color: var(--accent);
  }

  .result p {
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
</style>
