---
import '@fontsource-variable/inter';
// The file Inter's CSS loads for Latin text, requested before that CSS is even parsed.
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { pageLocale } from '../i18n';
import { FONTS, fontFace } from '../i18n/fonts';
import { LOCALES, localePath } from '../i18n/locales';

type Props = {
  title: string;
  description: string;
  /** schema.org objects, for search results. */
  schema?: Record<string, unknown>[];
} & ({ ogAlt: string; noindex?: never } | { ogAlt?: never; noindex: true });

const { title, description, schema = [], ogAlt, noindex = false } = Astro.props;
const { locale, path } = pageLocale(Astro.url);
const font = locale === 'en' ? undefined : FONTS[locale];
// "</script>" inside a string would end the tag early.
const ld = (o: Record<string, unknown>) => JSON.stringify({ '@context': 'https://schema.org', ...o }).replace(/</g, '\\u003c');
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), Astro.site)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />}
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    {font && <link rel="preload" href={font.url} as="font" type="font/woff2" crossorigin />}
    {font && <style is:inline set:html={`${fontFace(font)}:root{--script:'${font.family}'}`} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#050506" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Manyx Labs" />
    <meta property="og:locale" content={`${locale}_IN`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? title} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Before first paint, so a saved theme never flashes the other one. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    {schema.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* Each token holds both themes; color-scheme picks one, so the toggle only sets that. */
  :root {
    color-scheme: light dark;
    --bg: light-dark(#f5f6f8, #050506);
    --border: light-dark(#e4e4e8, #1f1f23);
    --glass: light-dark(rgb(255 255 255 / 0.55), rgb(28 28 32 / 0.5));
    --glass-edge: light-dark(rgb(255 255 255 / 0.8), rgb(255 255 255 / 0.1));
    --glass-shine: light-dark(rgb(255 255 255 / 0.95), rgb(255 255 255 / 0.08));
    --shadow: light-dark(rgb(15 23 42 / 0.12), rgb(0 0 0 / 0.55));
    --text: light-dark(#1d1d1f, #f5f5f7);
    --muted: light-dark(#6e6e73, #a1a1a6);
    --accent: light-dark(#059669, #34d399);
    --accent-soft: light-dark(rgb(5 150 105 / 0.1), rgb(52 211 153 / 0.12));
    --on-accent: light-dark(#ffffff, #050506);
  }

  :root[data-theme='light'] {
    color-scheme: light;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    /* Inter for Latin text and digits, then the page's own script, if it has one. */
    font-family: 'Inter Variable', var(--script, system-ui), system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* The colour field the glass frosts. Fixed, so panes shift tint as the page scrolls. */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42rem 32rem at 12% 8%, light-dark(rgb(16 185 129 / 0.2), rgb(16 185 129 / 0.2)), transparent 70%),
      radial-gradient(38rem 30rem at 90% 18%, light-dark(rgb(56 189 248 / 0.2), rgb(59 130 246 / 0.16)), transparent 70%),
      radial-gradient(44rem 34rem at 55% 92%, light-dark(rgb(167 139 250 / 0.18), rgb(139 92 246 / 0.14)), transparent 70%);
    pointer-events: none;
  }

  .glass {
    border: 1px solid var(--glass-edge);
    background: var(--glass);
    box-shadow:
      inset 0 1px 0 var(--glass-shine),
      0 12px 40px -18px var(--shadow);
    -webkit-backdrop-filter: blur(20px) saturate(170%);
    backdrop-filter: blur(20px) saturate(170%);
  }

  @media (prefers-reduced-transparency: reduce) {
    .glass {
      background: light-dark(#ffffff, #141417);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  /* Indic matras reach above and below the Latin line, and letter-spacing pulls conjuncts apart.
     :root lifts this over the pages' scoped heading styles. */
  :root :is(h1, h2, h3, .eyebrow):not(:lang(en)) {
    line-height: 1.4;
    letter-spacing: normal;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 20px;
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    background: var(--glass);
    box-shadow: inset 0 1px 0 var(--glass-shine);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
    backdrop-filter: blur(16px) saturate(170%);
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .btn:hover {
    border-color: var(--muted);
  }

  .btn.primary {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 8px 24px -10px var(--accent);
    color: var(--on-accent);
  }

  .btn.primary:hover {
    filter: brightness(1.08);
  }

  /* Component display rules would otherwise override the hidden attribute. */
  [hidden] {
    display: none !important;
  }

  .wrap {
    width: 100%;
    max-width: 1040px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  @media (min-width: 640px) {
    .wrap {
      padding-inline: 32px;
    }
  }
</style>
