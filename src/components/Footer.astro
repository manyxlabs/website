---
import { EMAIL, FOUNDER, GITHUB } from '../site';
---

<footer class="wrap">
  <div class="foot">
    <p>&copy; {new Date().getFullYear()} Manyx Labs, Bengaluru</p>
    <nav aria-label="Elsewhere">
      <a href="/photo-size/">Size guides</a>
      <a href={GITHUB}>GitHub</a>
      <a href={FOUNDER}>Founder</a>
      <a href={`mailto:${EMAIL}`}>Email</a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: space-between;
    padding-block: 32px 40px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
  }

  nav {
    display: flex;
    gap: 20px;
  }

  nav a {
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }
</style>
