---
import { pageLocale } from '../i18n';
import { LOCALES, localePath, NAMES } from '../i18n/locales';

const { locale, path, t, href } = pageLocale(Astro.url);
---

<header class="top">
  <div class="wrap">
    <div class="bar glass">
      <a href={href('/')} class="brand" aria-label={t.header.home}>
        <svg width="28" height="28" viewBox="0 0 48 48" aria-hidden="true">
          <defs>
            <mask id="mx" maskUnits="userSpaceOnUse" x="0" y="0" width="48" height="48">
              <rect width="48" height="48" fill="#fff"></rect>
              <circle cx="24" cy="24" r="9" fill="#000"></circle>
            </mask>
          </defs>
          <g mask="url(#mx)" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round">
            <path d="M9 9 C 22 20, 26 28, 39 39"></path>
            <path d="M39 9 C 26 20, 22 28, 9 39"></path>
          </g>
          <circle cx="24" cy="24" r="5" fill="var(--accent)"></circle>
        </svg>
        Manyx Labs
      </a>
      <nav aria-label={t.header.nav}>
        <a class="wide" href={`${href('/')}#products`}>{t.header.products}</a>
        <a class="wide" href={`${href('/')}#teams`}>{t.header.work}</a>
        <details class="lang">
          <summary aria-label={`${t.language}: ${NAMES[locale]}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
            </svg>
            <span class="current">{NAMES[locale]}</span>
          </summary>
          <ul class="glass">
            {
              LOCALES.map((l) => (
                <li>
                  <a href={localePath(l, path)} lang={l} hreflang={l} aria-current={l === locale ? 'true' : undefined}>{NAMES[l]}</a>
                </li>
              ))
            }
          </ul>
        </details>
        <button class="theme" type="button" aria-label={t.header.theme} data-to-light={t.header.toLight} data-to-dark={t.header.toDark}>
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
          </svg>
        </button>
      </nav>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme')!;
  const current = () => root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const label = () => button.setAttribute('aria-label', current() === 'dark' ? button.dataset.toLight! : button.dataset.toDark!);
  label();
  button.addEventListener('click', () => {
    root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', root.dataset.theme);
    } catch {}
    label();
  });

  // A <details> menu opens and closes from the keyboard by itself; this closes it the way menus do.
  const menu = document.querySelector<HTMLDetailsElement>('.lang')!;
  // A tool opened on a preset (?preset=) stays on it in the other language.
  for (const a of menu.querySelectorAll('a')) a.search = location.search;
  document.addEventListener('click', (e) => {
    if (!menu.contains(e.target as Node)) menu.open = false;
  });
  menu.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !menu.open) return;
    menu.open = false;
    menu.querySelector('summary')!.focus();
  });
</script>

<style>
  /* A floating glass bar that stays put while the page scrolls under it. */
  .top {
    position: sticky;
    top: 12px;
    z-index: 10;
    margin-block: 12px 8px;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 8px 8px 16px;
    border-radius: 999px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  @media (max-width: 479px) {
    nav {
      gap: 14px;
    }
  }

  /* The narrowest phones keep only the icons; the logo and the hero's buttons lead to the rest. */
  @media (max-width: 419px) {
    .wide {
      display: none;
    }
  }

  .lang {
    position: relative;
  }

  .lang summary {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 36px;
    height: 36px;
    padding-inline: 8px;
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    background: var(--glass);
    color: var(--muted);
    font-size: 0.875rem;
    list-style: none;
    cursor: pointer;
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .lang summary:hover,
  .lang[open] summary {
    color: var(--text);
    border-color: var(--muted);
  }

  .lang svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  @media (max-width: 479px) {
    .current {
      display: none;
    }
  }

  .lang ul {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    margin: 0;
    padding: 6px;
    border-radius: 16px;
    list-style: none;
    /* The glass alone is too faint over the page below it. */
    background: light-dark(#ffffff, #141417);
  }

  .lang ul a {
    display: block;
    padding: 6px 14px;
    border-radius: 10px;
    color: var(--text);
  }

  .lang ul a:hover {
    background: var(--accent-soft);
  }

  .lang ul a[aria-current] {
    color: var(--accent);
    font-weight: 600;
  }

  .theme {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    background: var(--glass);
    color: var(--muted);
    cursor: pointer;
  }

  .theme:hover {
    color: var(--text);
    border-color: var(--muted);
  }

  .theme svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The icon shows the theme a click switches to. */
  .moon,
  :global(:root[data-theme='dark']) .sun {
    display: block;
  }

  .sun,
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }

  nav a {
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--text);
  }
</style>
