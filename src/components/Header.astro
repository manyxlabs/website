---
import { pageLocale } from '../i18n';
import { LOCALES, localePath, NAMES } from '../i18n/locales';

const { locale, path, t, href } = pageLocale(Astro.url);
---

<header class="top">
  <div class="bar glass">
    <a href={href('/')} class="brand" aria-label={t.header.home}>
      <svg width="28" height="28" viewBox="0 0 48 48" aria-hidden="true">
        <defs>
          <mask id="mx" maskUnits="userSpaceOnUse" x="0" y="0" width="48" height="48">
            <rect width="48" height="48" fill="#fff"></rect>
            <circle cx="24" cy="24" r="9" fill="#000"></circle>
          </mask>
        </defs>
        <g mask="url(#mx)" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round">
          <path d="M9 9 C 22 20, 26 28, 39 39"></path>
          <path d="M39 9 C 26 20, 22 28, 9 39"></path>
        </g>
        <circle cx="24" cy="24" r="5" fill="rgb(var(--accent))"></circle>
      </svg>
      Manyx Labs
    </a>
    <nav aria-label={t.header.nav}>
      <a class="wide" href={`${href('/')}#products`}>{t.header.products}</a>
      <a class="wide" href={`${href('/')}#teams`}>{t.header.work}</a>
      <details class="lang">
        <summary aria-label={`${t.language}: ${NAMES[locale]}`}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
          </svg>
          <span class="current">{NAMES[locale]}</span>
        </summary>
        <ul>
          {
            LOCALES.map((l) => (
              <li>
                <a href={localePath(l, path)} lang={l} hreflang={l} aria-current={l === locale ? 'true' : undefined}>{NAMES[l]}</a>
              </li>
            ))
          }
        </ul>
      </details>
      <button class="theme" type="button" aria-label={t.header.theme} data-to-light={t.header.toLight} data-to-dark={t.header.toDark}>
        <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme')!;
  // Base's head script has already applied the saved or system theme.
  const dark = () => root.classList.contains('dark');
  const label = () => button.setAttribute('aria-label', dark() ? button.dataset.toLight! : button.dataset.toDark!);
  label();
  button.addEventListener('click', () => {
    const next = !dark();
    root.classList.toggle('dark', next);
    try {
      localStorage.setItem('theme', next ? 'dark' : 'light');
    } catch {}
    label();
  });

  // A <details> menu opens and closes from the keyboard by itself; this closes it the way menus do.
  const menu = document.querySelector<HTMLDetailsElement>('.lang')!;
  // A tool opened on a preset (?preset=) stays on it in the other language.
  for (const a of menu.querySelectorAll('a')) a.search = location.search;
  document.addEventListener('click', (e) => {
    if (!menu.contains(e.target as Node)) menu.open = false;
  });
  menu.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !menu.open) return;
    menu.open = false;
    menu.querySelector('summary')!.focus();
  });
</script>

<style>
  /* The portfolio's navbar: a glass pill floating 16px from the top. The header keeps its height
     in the flow, so pages start below the pill without each one reserving space for it. */
  .top {
    height: 88px;
  }

  .bar {
    position: fixed;
    top: 16px;
    left: 16px;
    right: 16px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 64rem;
    margin-inline: auto;
    padding: 8px 8px 8px 20px;
    border-radius: 999px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  nav a {
    padding: 8px 16px;
    border-radius: 999px;
    color: rgb(var(--muted));
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  nav a:hover {
    background: rgb(var(--fg) / 0.05);
    color: rgb(var(--fg));
  }

  /* Phones keep only the icons; the logo and the home page's buttons lead to the rest. */
  @media (max-width: 767px) {
    .wide {
      display: none;
    }
  }

  /* Round icon buttons, like the portfolio's theme toggle. */
  .lang summary,
  .theme {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 40px;
    height: 40px;
    padding: 0 10px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: rgb(var(--fg));
    font: inherit;
    font-size: 0.875rem;
    list-style: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .lang summary:hover,
  .lang[open] summary,
  .theme:hover {
    background: rgb(var(--fg) / 0.1);
  }

  .lang svg,
  .theme svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 479px) {
    .current {
      display: none;
    }
  }

  /* Placed against the bar, not the menu button, so it lines up with the pill's edge.
     Opaque: the bar's glass would be its backdrop root and leave a nested blur flat. */
  .lang ul {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    min-width: 168px;
    margin: 0;
    padding: 8px;
    border: 1px solid rgb(var(--fg) / 0.1);
    border-radius: 24px;
    background: rgb(var(--ink));
    box-shadow: var(--glass-shadow);
    list-style: none;
  }

  .lang ul a {
    display: block;
    padding: 8px 16px;
    border-radius: 16px;
    color: rgb(var(--muted));
    font-size: 0.9375rem;
  }

  .lang ul a:hover {
    background: rgb(var(--fg) / 0.05);
    color: rgb(var(--fg));
  }

  .lang ul a[aria-current] {
    color: rgb(var(--fg));
    font-weight: 600;
  }

  .theme {
    width: 40px;
    padding: 0;
  }

  /* The icon shows the theme a click switches to. */
  .sun,
  :global(.dark) .moon {
    display: none;
  }

  :global(.dark) .sun {
    display: block;
  }
</style>
